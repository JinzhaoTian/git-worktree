{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    // The shared view under `src/view` is a transcription of the hand-written
    // panel, so its render bodies carry implicit `any` parameters while its
    // payloads, panel state and transport are typed. See `tsconfig.view.json`.
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true
  },
  "include": ["src/ui/**/*.tsx", "src/ui/**/*.ts", "src/shared/**/*.ts"]
}
