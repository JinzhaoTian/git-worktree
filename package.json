{
  "name": "@JinzhaoTian/git-worktree-graph",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Git worktree browser as a native DSH right-sidebar tab.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "meta": {
    "title": "Git Worktree Graph",
    "description": "Browse this workspace's Git worktrees, branches and commit history in a right-sidebar tab."
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
