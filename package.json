{
  "name": "git-worktree-integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:dsh": "node integrations/dsh-plugin/scripts/build-dsh.mjs",
    "typecheck:dsh": "tsc -p tsconfig.view.json && tsc -p integrations/dsh-plugin/tsconfig.host.json && tsc -p integrations/dsh-plugin/tsconfig.client.json",
    "verify:dsh": "node integrations/dsh-plugin/scripts/verify-dsh.mjs",
    "geometry:dsh": "node integrations/dsh-plugin/scripts/geometry-dsh.mjs",
    "test": "npm run verify:dsh",
    "check:dsh": "npm run build:dsh && npm run typecheck:dsh && npm run verify:dsh && npm run geometry:dsh",
    "check": "npm run build:dsh && npm run typecheck:dsh && npm test && npm run geometry:dsh"
  },
  "dependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
